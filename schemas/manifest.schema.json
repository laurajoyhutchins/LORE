{
  "$id": "manifest",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": true,
  "properties": {
    "schema_version": {
      "const": 1
    }
  },
  "required": [
    "schema_version",
    "repository",
    "paths",
    "extractors",
    "projections",
    "maintenance",
    "hydration"
  ],
  "type": "object"
}
