{
  "name": "@laurajoyhutchins/lore",
  "version": "0.1.0",
  "license": "Apache-2.0",
  "description": "Maintenance-mode repository documentation and bounded context utility.",
  "keywords": ["documentation", "repository", "provenance", "architecture"],
  "homepage": "https://github.com/laurajoyhutchins/LORE#readme",
  "bugs": { "url": "https://github.com/laurajoyhutchins/LORE/issues" },
  "repository": { "type": "git", "url": "git+https://github.com/laurajoyhutchins/LORE.git" },
  "packageManager": "pnpm@10.14.0",
  "type": "module",
  "bin": { "lore": "./dist/cli/main.js" },
  "files": ["dist/", "README.md", "LICENSE"],
  "publishConfig": { "access": "public" },
  "engines": { "node": ">=22" },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "lore": "tsx src/cli/main.ts",
    "ci": "pnpm lint && pnpm typecheck && pnpm test && pnpm build && pnpm lore validate . && pnpm lore project . --check",
    "prepack": "pnpm run ci"
  },
  "dependencies": { "yaml": "^2.8.1" },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.2.0",
    "eslint": "^10.8.1",
    "tsx": "^4.20.3",
    "typescript": "^7.0.2",
    "typescript-eslint": "^8.38.0",
    "vitest": "^4.1.11"
  }
}
