{
  "name": "@laurajoyhutchins/lore",
  "version": "0.0.0-bootstrap.0",
  "license": "Apache-2.0",
  "description": "Agent-neutral, Git-backed repository evidence and documentation system.",
  "keywords": [
    "documentation",
    "git",
    "repository",
    "provenance",
    "architecture",
    "agents"
  ],
  "homepage": "https://github.com/laurajoyhutchins/LORE#readme",
  "bugs": {
    "url": "https://github.com/laurajoyhutchins/LORE/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/laurajoyhutchins/LORE.git"
  },
  "packageManager": "pnpm@10.14.0",
  "type": "module",
  "bin": {
    "lore": "./dist/cli/main.js"
  },
  "files": [
    "dist/",
    "BOOTSTRAP.md",
    "schemas/",
    "skills/maintain-repository-documentation/",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepack": "corepack pnpm build",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "lore": "tsx src/cli/main.ts",
    "release:refresh": "node scripts/public-release-gate.mjs --refresh-generated",
    "release:verify": "node scripts/public-release-gate.mjs",
    "release:restore-lock": "node scripts/restore-verified-lockfile.mjs"
  },
  "dependencies": {
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "yaml": "^2.8.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.31.0",
    "@types/node": "^22.17.0",
    "eslint": "^9.31.0",
    "tsx": "^4.20.3",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.38.0",
    "vitest": "^3.2.4"
  }
}
